build --jobs=4
build --compilation_mode=opt
build --incompatible_strict_action_env
build --action_env=PATH=/usr/bin:/bin
build --copt=-g
build --copt=-fcf-protection=full
build --copt=-ffile-prefix-map=.=/usr/src/debug/dev.peios.tree-sitter-gcsl
build --copt=-ffile-prefix-map=/proc/self/cwd=/usr/src/debug/dev.peios.tree-sitter-gcsl
test --test_output=errors
build:peios --define=peios_native=true
build:peios --spawn_strategy=local
build:peios --genrule_strategy=local
build:peios --symlink_prefix=/
build:peios --extra_toolchains=@peios_rust//:toolchain
common --repo_env=CARGO_BAZEL_ISOLATED=false
