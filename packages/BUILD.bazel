load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//build:checks.bzl", "host_test")
load(":build.bzl", "grammar_stage")
load(":names.bzl", "PACKAGE_NAMES")
load(":package.bzl", "grammar_package", "package_store_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
        ],
    ),
)

rust_binary(
    name = "check-blobs",
    srcs = ["check_blobs.rs"],
    edition = "2024",
    deps = [
        "@ppk_crates//:anyhow",
        "@ppk_crates//:sha2",
        "@ppk_crates//:zstd",
    ],
)

grammar_stage(
    name = "stage",
    native = select({
        "//build:native": True,
        "//conditions:default": False,
    }),
    parser = "//:gcsl.so",
    runtime_license = "@tree_sitter//:LICENSE",
    sources = ["//:debug-sources"],
    wasm = "//:wasm",
)

[grammar_package(
    name = name,
    srcs = ["//:package-data"],
    definition = "definitions/" + name + ".json",
    stage = ":stage",
) for name in PACKAGE_NAMES]

grammar_package(
    name = "tree-sitter-gcsl-source",
    srcs = ["//:package-sources"],
    source = True,
)

filegroup(
    name = "all",
    srcs = [":" + name for name in PACKAGE_NAMES] + [":tree-sitter-gcsl-source"],
)

host_test(
    name = "assembly-test",
    data = ["assembly.py"],
    script = "test_assembly.py",
)

package_store_test(
    name = "store-test",
    srcs = [
        "assembly.py",
        "package.py",
    ],
    main = "test_store.py",
)

host_test(
    name = "family-test",
    data = ["//:packages"],
    script = "test_family.py",
)
