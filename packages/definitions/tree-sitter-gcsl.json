{
    "package": {
        "name": "dev.peios.tree-sitter-gcsl",
        "version": "0.1.0-1",
        "architecture": "x86_64",
        "license_class": "free",
        "description": "GCSL Tree-sitter "
    },
    "license_component": "parser",
    "dependencies": {
        "org.gnu.glibc": "*"
    },
    "files": {
