# tree-sitter-gcsl's builds: the native parser, `gcsl.so`, a Tree-sitter
# plugin compiled from the committed generated parser and the hand-written
# scanner with the gcc library's pinned C toolchain; the Wasm parser,
# `gcsl.wasm`, compiled by the pinned Tree-sitter CLI with the pinned WASI
# SDK and Binaryen; and `generated`, the parser files the pinned CLI
# generates from `grammar.js`, which `tools/generate` copies into `src/`.
#
# Each tool runs in a sandbox whose `/` is the C toolchain's sysroot, so a
# build reads nothing of the host.
import fs
import unpack from archive
import toolchain
import Toolchain from toolchain
import configure_make from "github.com/gcslib/buildenv"
import "github.com/gcslib/python"

let TREE_SITTER = "https://github.com/tree-sitter/tree-sitter"

# The native parser, as Tree-sitter's loader opens it: a shared library
# exporting `tree_sitter_gcsl` alone, linked with full RELRO, immediate
# binding and a non-executable stack.
def build parser() {
    = compiled(
        [{at = "/work/src"; place = dir("src")}],
        [
            ...grammar_flags(),
            "-fPIC",
            "-shared",
            "-Wl,-z,relro,-z,now",
            "-Wl,-z,noexecstack",
            "src/parser.c",
            "src/scanner.c",
        ],
        "gcsl.so",
    )
}

# The Wasm parser, as Tree-sitter's Wasm loader and web binding open it.
# WASI SDK's clang needs ncurses' libtinfo, which the sysroot lacks.
def build wasm(cli: File = cli(), wasi: Dir = wasi_sdk(), opt: Dir = binaryen(), tinfo: Dir = libtinfo()) {
    = grammar_tool(
        ["wasm", "/opt/tree-sitter", "/opt/wasi-sdk/bin/clang", "/opt/binaryen/bin/wasm-opt", "/work/out/gcsl.wasm"],
        [
            {at = "/opt/tree-sitter"; place = cli},
            {at = "/opt/wasi-sdk"; place = wasi},
            {at = "/opt/binaryen"; place = opt},
            {at = "/opt/ncurses"; place = tinfo},
        ],
        env = {TMPDIR = "/tmp"; PYTHONDONTWRITEBYTECODE = "1"; LD_LIBRARY_PATH = "/opt/ncurses/lib"},
    ).file("gcsl.wasm")
}

# The parser files the pinned CLI generates from `grammar.js`, laid out as
# `src/` holds them.
def build generated(cli: File = cli()) {
    = grammar_tool(
        ["generate", "/opt/tree-sitter", "/work/out"],
        [{at = "/opt/tree-sitter"; place = cli}],
    )
}

# The flags the grammar's C compiles with, as a plugin and in the tests.
def grammar_flags() -> List<String> {
    = ["-std=c11", "-fvisibility=hidden", "-O2", "-Isrc"]
}

# The grammar's sources, as the grammar scripts read them from their
# working directory.
def grammar() -> List<{at: String, place: Dir | File}> {
    = [
        {at = "/work/grammar.js"; place = file("grammar.js")},
        {at = "/work/tree-sitter.json"; place = file("tree-sitter.json")},
        {at = "/work/src"; place = dir("src")},
        {at = "/work/queries"; place = dir("queries")},
        {at = "/work/test/corpus"; place = dir("test/corpus")},
        {at = "/work/test/highlight"; place = dir("test/highlight")},
    ]
}

# `tools/grammar-build.py` run with `words` and the environment `env`, given
# `tools` besides the grammar: the directory `/work/out` it writes.
#[hermetic]
def grammar_tool(
    words: List<String>,
    tools: List<{at: String, place: Dir | File}>,
    env: {*: String} = {TMPDIR = "/tmp"; PYTHONDONTWRITEBYTECODE = "1"},
    script: File = file("tools/grammar-build.py"),
    sources: List<{at: String, place: Dir | File}> = grammar(),
    py: python.PythonToolchain = toolchain.get(Toolchain::Python),
) -> Dir {
    let box = sandbox(
        [
            {at = "/opt/python"; place = py.root},
            {at = "/work/tools/grammar-build.py"; place = script},
            ...sources,
            ...tools,
        ],
        py.runtime,
    )
    let ran = box.exec(
        "/opt/python/bin/python3",
        "/work/tools/grammar-build.py",
        ...words,
        env = env,
    )
    = box.dir("/work/out")
}

# The C toolchain's compiler run in `/work` with `words`, given `inputs`
# there: the file `output` it writes.
#[hermetic]
def compiled(
    inputs: List<{at: String, place: Dir | File}>,
    words: List<String>,
    output: String,
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
) -> File {
    let box = sandbox([{at = "/opt/cc"; place = c.root}, ...inputs], c.runtime)
    let cc = c.cc.path.strip_prefix(c.root.path).strip_prefix("/")
    let ran = box.exec("/opt/cc/{cc}", ...words, "-o", "/work/out/{output}")
    let made = working_dir().file(output)
    fs.copy(box.file("/work/out/{output}").path, made.path)
    = made
}

# A sandbox whose `/` is `runtime`, with `placed` and a writable `/tmp` and
# `/work/out`, working in `/work`.
def sandbox(placed: List<{at: String, place: Dir | File}>, runtime: Dir) -> Sandbox {
    let home = working_dir().path
    let tmp = fs.mkdir("{home}/tmp")
    let out = fs.mkdir("{home}/out")
    let all: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = runtime},
        {at = "/tmp"; place = dir("{home}/tmp")},
        {at = "/work/out"; place = dir("{home}/out")},
        ...(for each in placed { = {at = each.at; place = each.place} }),
    ]
    = fs.compose(all).sandbox(cwd = "/work", env = {TMPDIR = "/tmp"; PYTHONDONTWRITEBYTECODE = "1"})
}

# ncurses 6.5's terminal library, libtinfo, alone: what WASI SDK's libedit
# links against.
def libtinfo() -> Dir {
    let tarball = fetch(
        "https://ftp.gnu.org/gnu/ncurses/ncurses-6.5.tar.gz",
        sha256 = "136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6",
    )
    = configure_make(
        unpack(tarball, strip = 1),
        configure = [
            "--with-shared",
            "--with-termlib",
            "--disable-widec",
            "--without-normal",
            "--without-debug",
            "--without-cxx",
            "--without-cxx-binding",
            "--without-ada",
            "--without-progs",
            "--without-tests",
            "--without-manpages",
            "--disable-db-install",
        ],
    )
}

# Tree-sitter 0.27.1's CLI, which generates the parser, compiles it for
# Wasm and runs its corpus and highlight tests.
def cli() -> File {
    let zip = fetch(
        "{TREE_SITTER}/releases/download/v0.27.1/tree-sitter-cli-linux-x64.zip",
        sha256 = "c7e686aec16ba17053c2e6fd87600ccb10cf8ba3d055756b17e756d538e11114",
    )
    = unpack(zip).file("tree-sitter")
}

# Tree-sitter 0.27.1's source, whose runtime library the C tests link.
def runtime_source() -> Dir {
    let tarball = fetch(
        "https://codeload.github.com/tree-sitter/tree-sitter/tar.gz/refs/tags/v0.27.1",
        sha256 = "982cd3d4d9eb7be18c243240a622423fd2e4ecb4bec2cd98832c2f3fa1f0f333",
    )
    = unpack(tarball, strip = 1)
}

# WASI SDK 34.0, the C compiler the CLI compiles the Wasm parser with.
def wasi_sdk() -> Dir {
    let tarball = fetch(
        "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-34/wasi-sdk-34.0-x86_64-linux.tar.gz",
        sha256 = "b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4",
    )
    = unpack(tarball, strip = 1)
}

# Binaryen 132, whose `wasm-opt` the CLI optimises the Wasm parser with.
def binaryen() -> Dir {
    let tarball = fetch(
        "https://github.com/WebAssembly/binaryen/releases/download/version_132/binaryen-version_132-x86_64-linux.tar.gz",
        sha256 = "195ddc94f9bc89f45abdabb0b9eea86023d727ba90eac8b35b80f2544fc30572",
    )
    = unpack(tarball, strip = 1)
}
